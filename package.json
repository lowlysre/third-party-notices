{
  "name": "third-party-notices",
  "version": "0.1.0",
  "description": "Zero-dependency CLI that generates third-party license notice files for npm projects",
  "keywords": [
    "license",
    "licenses",
    "notices",
    "third-party",
    "attribution",
    "cli"
  ],
  "license": "ISC",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lowlysre/third-party-notices.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "third-party-notices": "dist/cli.js",
    "tpn": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/testing",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "test:coverage": "npm run build && node --test --experimental-test-coverage \"dist/**/*.test.js\"",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
